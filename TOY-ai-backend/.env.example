# ---- Server ----
AI_HOST=127.0.0.1
AI_PORT=8000
AI_ENV=development
# Comma separated. Only the Node API should ever reach this service.
AI_CORS_ORIGINS=http://localhost:3000

# Shared secret. The Node API sends it as `x-ai-service-token`; requests without
# it are rejected. Leave empty ONLY for local experiments.
AI_SERVICE_TOKEN=change-me-ai-service-token

# ---- Provider switch (TOY.md: "keep a boolean to switch between openai and
# <provider> - either one should work") ----
# true  -> Groq
# false -> OpenAI
USE_GROQ=true
# Optional override. Set it to name a provider outright ("groq", "openai" or
# the legacy "gemini") and USE_GROQ is ignored. Leave empty normally.
AI_PROVIDER=

# ---- Groq (default) ----
# Set it in this file. This service is the only process that holds provider
# keys, so the key belongs here rather than in any enclosing .env.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=
# Free-tier friendly and supports JSON response_format.
# Alternatives: openai/gpt-oss-20b (faster/cheaper), groq/compound.
# Check what your key can reach: GET https://api.groq.com/openai/v1/models
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com
# The gpt-oss models are reasoners and spend the output budget thinking
# before they answer. "low" | "medium" | "high"; leave EMPTY if you switch
# GROQ_MODEL to a non-reasoning model, which rejects the field.
GROQ_REASONING_EFFORT=low

# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com

# ---- Google Gemini (legacy; only reachable via AI_PROVIDER=gemini) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# ---- Generation tuning ----
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
AI_TEMPERATURE=0.7
AI_MAX_OUTPUT_TOKENS=2048
