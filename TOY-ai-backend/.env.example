# ---- Server ----
AI_HOST=127.0.0.1
AI_PORT=8000
AI_ENV=development
# Comma separated. Only the Node API should ever reach this service.
AI_CORS_ORIGINS=http://localhost:3000

# Shared secret. The Node API sends it as `x-ai-service-token`; requests without
# it are rejected. Leave empty ONLY for local experiments.
AI_SERVICE_TOKEN=change-me-ai-service-token

# ---- Provider switch (TOY.md: "keep a boolean to switch between openai and
# google gemini - either one should work") ----
# true  -> Google Gemini
# false -> OpenAI
USE_GEMINI=true

# ---- Google Gemini ----
# Read from this file, or from the repository-root .env, which already holds
# GEMINI_API_KEY. The root file wins only when this one leaves the key empty.
GEMINI_API_KEY=
# Free-tier friendly small model. The "-latest" alias survives model retirement.
# Alternatives: gemini-2.5-flash-lite, gemini-3.5-flash-lite, gemini-flash-latest.
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com

# ---- Generation tuning ----
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
AI_TEMPERATURE=0.7
AI_MAX_OUTPUT_TOKENS=2048
