# =============================================================================
# AI service — production configuration template
# =============================================================================
# Copy to `.env.production` in this directory, or inject these as real
# environment variables. `.env.production` is gitignored; this template is not,
# so it must never hold a real value.
#
# Unlike development, production does NOT walk up the directory tree looking
# for enclosing `.env` files. A service started with AI_ENV=production on a
# machine that has a developer's TOY-backend/.env above it would otherwise
# adopt their shared secret and their CORS origins without saying so.
#
# This is the only process that holds provider API keys. They belong here and
# nowhere else — never in the Node backend, never in Angular, never in the app.

AI_ENV=production
AI_HOST=127.0.0.1
AI_PORT=8000

# Who may call this service. Only the Node API ever should, and it reaches this
# process over a private network or the loopback interface — so this is the
# origin the Node API presents, not a public one. Startup is refused if a
# localhost origin or a wildcard is left here.
AI_CORS_ORIGINS=https://offersoffer.in

# Shared secret. The Node API sends it as `x-ai-service-token`; requests without
# it are rejected. Must match RAZORPAY-style secrecy: it is a credential.
# Must equal AI_SERVICE_TOKEN in the Node backend's production configuration.
# Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(36))"
AI_SERVICE_TOKEN=<secret>

# ---- Provider ----
# true -> Google Gemini, false -> OpenAI. Only the selected provider's key is
# required; startup is refused if it is missing.
USE_GEMINI=true

GEMINI_API_KEY=<secret>
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com

# ---- Generation tuning ----
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
AI_TEMPERATURE=0.7
AI_MAX_OUTPUT_TOKENS=2048
