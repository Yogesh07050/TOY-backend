# ---- Server ----
NODE_ENV=development
PORT=3000
API_PREFIX=/api
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:4200

# Public base URL of this API (used to build absolute image URLs)
PUBLIC_API_URL=http://localhost:3000
# Public base URL of the Angular app (used in emails + share links)
APP_URL=http://localhost:4200

# ---- Database ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=offers_app
DB_CONNECTION_LIMIT=10

# ---- Auth ----
# Use long random strings in any non-local environment
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# ---- Email (nodemailer) ----
# When SMTP_HOST is empty, emails are logged to the console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Offers App <no-reply@offers.app>"

# ---- Uploads ----
# local | s3  (only "local" is implemented; s3 stub documented in README)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ---- Seed super admin ----
SEED_SUPERADMIN_EMAIL=superadmin@offers.app
SEED_SUPERADMIN_PASSWORD=SuperAdmin@123
SEED_DEMO_DATA=true
