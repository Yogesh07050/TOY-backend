# ---- Server ----
NODE_ENV=development
PORT=3000
API_PREFIX=/api
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:4200

# Public base URL of this API (used to build absolute image URLs)
PUBLIC_API_URL=http://localhost:3000
# Public base URL of the Angular app (used in emails + share links)
APP_URL=http://localhost:4200

# ---- Database ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=offers_app
DB_CONNECTION_LIMIT=10

# ---- Auth ----
# Use long random strings in any non-local environment
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# ---- Email (nodemailer) ----
# Verification and password-reset links are emailed from here.
#
# Leave SMTP_HOST empty and NOTHING IS SENT: messages are written to
# ./mail-outbox/*.html and the link is printed to the server log, so you can
# still complete signup locally. The API reports delivered:false in that case.
#
# Gmail (needs a 16-character App Password, not your account password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=abcdefghijklmnop
#
# Mailtrap / Ethereal, for testing without real delivery:
#   SMTP_HOST=sandbox.smtp.mailtrap.io
#   SMTP_PORT=2525
#   SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Offers App <no-reply@offers.app>"

# ---- Uploads ----
# local | s3  (only "local" is implemented; s3 stub documented in README)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ---- Discovery (V2) ----
# Default "Near me" radius, the Ending Soon window, and the threshold below
# which an offer is shown as urgent.
DISCOVERY_DEFAULT_RADIUS_KM=10
DISCOVERY_ENDING_SOON_HOURS=72
DISCOVERY_URGENT_HOURS=6

# ---- Payments: Razorpay ----
# Leave RAZORPAY_KEY_ID empty and checkout answers 503 PAYMENTS_NOT_CONFIGURED
# rather than failing deep inside an HTTP call. The plan catalogue reports
# payment.enabled=false so the UI can say so up front.
#
# Test credentials come from the Razorpay Dashboard > Settings > API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks. Subscribe the endpoint
#   POST {PUBLIC_API_URL}/api/payments/razorpay/webhook
# to: payment.authorized, payment.captured, payment.failed,
#     subscription.authenticated, subscription.activated, subscription.charged,
#     subscription.pending, subscription.halted, subscription.paused,
#     subscription.resumed, subscription.cancelled, subscription.completed,
#     refund.created, refund.processed
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE=https://api.razorpay.com/v1

# Razorpay Plan ids (Dashboard > Subscriptions > Plans), one per paid plan.
# Recurring billing and UPI AutoPay are created against these; without them the
# corresponding plan cannot be purchased.
#   Business = Rs 999 / month, Premium = Rs 2,500 / month
RAZORPAY_PLAN_BUSINESS=
RAZORPAY_PLAN_PREMIUM=
# Billing cycles a mandate is authorised for before it must be renewed.
RAZORPAY_TOTAL_COUNT=120

# ---- Billing behaviour ----
# Days a failed renewal keeps its features before the plan drops to Free.
# Merchant data is never deleted, only the plan changes.
BILLING_GRACE_DAYS=5
# Tax already included in the plan price; invoices back-compute the split.
BILLING_TAX_PERCENT=18
BILLING_INVOICE_PREFIX=INV

# ---- Refresh cookie (web persistent login) ----
# The refresh token is set as an httpOnly cookie for the Angular app.
# Same-site API + SPA:      SAMESITE=lax
# API on a different site:  SAMESITE=none  (browsers then require SECURE=true)
# Defaults: lax/false in development, none/true in production.
REFRESH_COOKIE_SAMESITE=
REFRESH_COOKIE_SECURE=
REFRESH_COOKIE_DOMAIN=

# ---- Seed super admin ----
SEED_SUPERADMIN_EMAIL=superadmin@offers.app
SEED_SUPERADMIN_PASSWORD=SuperAdmin@123
SEED_DEMO_DATA=true
